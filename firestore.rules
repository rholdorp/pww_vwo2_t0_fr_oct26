rules_version = '2';

// Design D7: everyone with the app may read and add, nobody may change or
// delete answers or test results. The name key is the identity.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validKey(key) {
      return key.matches('^[a-z0-9-]{2,20}$');
    }

    function smallString(v, max) {
      return v is string && v.size() <= max;
    }

    match /learners/{key} {
      allow read: if signedIn();

      allow create, update: if signedIn() && validKey(key)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'lastActive', 'summary'])
        && smallString(request.resource.data.displayName, 20)
        && request.resource.data.lastActive is int
        && (!('summary' in request.resource.data) || request.resource.data.summary is map);

      allow delete: if false;

      match /answers/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && validKey(key)
          && request.resource.data.keys().hasOnly(['items', 'ms', 'fast', 'at', 'mode', 'sessionId'])
          && request.resource.data.items is map
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 6
          && request.resource.data.ms is int
          && request.resource.data.fast is bool
          && request.resource.data.at is int
          && request.resource.data.mode in ['mc', 'type', 'test']
          && smallString(request.resource.data.sessionId, 40);
        allow update, delete: if false;
      }

      match /tests/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && validKey(key)
          && request.resource.data.keys().hasOnly(['at', 'score', 'total', 'grade', 'durationMs'])
          && request.resource.data.at is int
          && request.resource.data.score is int
          && request.resource.data.total is int
          && request.resource.data.grade is number
          && request.resource.data.durationMs is int;
        allow update, delete: if false;
      }
    }
  }
}
